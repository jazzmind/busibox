# Embedding API Environment Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

# FastEmbed model configuration (derived from model_registry.yml)
{% set embedding_model_key = (default_purposes | default({}) | combine(model_purposes | default({}))).embedding | default('bge-large') %}
{% set embedding_model_config = available_models[embedding_model_key] | default({}) %}
FASTEMBED_MODEL={{ embedding_model_config.model_name | default('BAAI/bge-large-en-v1.5') }}
EMBEDDING_BATCH_SIZE={{ embedding_batch_size }}

# Cache directory (used by both embedding-api and fastembed library)
FASTEMBED_CACHE_DIR={{ embedding_cache_dir }}

# ONNX Runtime thread control
# In LXC containers ONNX sees all host CPUs but cgroups restrict which are
# usable, leading to pthread_setaffinity_np failures and oversized thread
# pools that OOM-kill the process during inference batches.
# EMBEDDING_THREADS is passed to FastEmbed's TextEmbedding(threads=N) which
# sets both intra_op_num_threads and inter_op_num_threads on the ONNX session.
# The OMP/ONNXRUNTIME env vars are belt-and-suspenders for any code paths
# that create sessions outside of FastEmbed.
EMBEDDING_THREADS={{ embedding_intra_op_threads }}
OMP_NUM_THREADS={{ embedding_intra_op_threads }}
ONNXRUNTIME_INTRA_OP_NUM_THREADS={{ embedding_intra_op_threads }}
ONNXRUNTIME_INTER_OP_NUM_THREADS={{ embedding_inter_op_threads }}

# Server configuration
PORT={{ embedding_api_port }}
