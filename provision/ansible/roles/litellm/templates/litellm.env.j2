# LiteLLM Environment Configuration
# Auto-generated by Ansible - modifications will be overwritten

# Master Key (authentication only - used by clients to call LiteLLM API)
LITELLM_MASTER_KEY={{ litellm_master_key }}
# Salt key is the SOLE encryption key for all DB-stored data (model configs,
# credentials, env vars). Must remain stable; rotating it requires DB purge.
# Falls back to master key for backward compat with pre-salt deployments.
LITELLM_SALT_KEY={{ busibox_secrets.LITELLM_SALT_KEY }}

# Logging
LITELLM_LOG={{ litellm_log_level | upper }}

{% if litellm_enable_database %}
# Database
DATABASE_URL={{ litellm_database_url }}
LITELLM_DATABASE_URL={{ litellm_database_url }}
STORE_MODEL_IN_DB=True
{% endif %}

# Determine what config-api has so vault keys don't clobber it
{% set _cfg = _config_api_llm_keys | default({}) %}
{% set _cfg_has_access_key = 'AWS_ACCESS_KEY_ID' in _cfg and _cfg['AWS_ACCESS_KEY_ID'] | length > 0 %}
{% set _cfg_has_secret_key = 'AWS_SECRET_ACCESS_KEY' in _cfg and _cfg['AWS_SECRET_ACCESS_KEY'] | length > 0 %}
{% set _cfg_has_iam_keys   = _cfg_has_access_key and _cfg_has_secret_key %}

# Track exactly which individual keys vault has already written
{% set _vault_bedrock_key = secrets.bedrock_api_key | default(secrets.bedrock.api_key | default('')) %}
{% set _vault_wrote_bearer     = _vault_bedrock_key | length > 0 and not _cfg_has_iam_keys %}
{% set _vault_wrote_access_key = _vault_wrote_bearer and ':' in _vault_bedrock_key %}
{% set _vault_wrote_secret_key = _vault_wrote_access_key %}
{% set _vault_wrote_region     = (secrets.bedrock_region | default(secrets.bedrock.region | default(''))) | length > 0 %}
{% set _vault_wrote_openai     = (secrets.openai is defined and secrets.openai.api_key is defined and secrets.openai.api_key | length > 0) %}

# API keys from vault
{% if _vault_wrote_openai %}
OPENAI_API_KEY={{ busibox_secrets.OPENAI_API_KEY }}
{% endif %}
{% if _vault_wrote_bearer %}
# Vault bearer token (only used when config-api does not have IAM keys)
AWS_BEARER_TOKEN_BEDROCK={{ _vault_bedrock_key }}
{% if _vault_wrote_access_key %}
AWS_ACCESS_KEY_ID={{ _vault_bedrock_key.split(':')[0] }}
AWS_SECRET_ACCESS_KEY={{ _vault_bedrock_key.split(':')[1] }}
{% endif %}
{% endif %}
{% if _vault_wrote_region %}
AWS_REGION={{ secrets.bedrock_region | default(secrets.bedrock.region | default('')) }}
{% endif %}

# API keys from config-api database (set via admin UI)
# Each key is only written if vault did not already provide that specific key.
{% for k, v in _cfg.items() %}
{% if v %}
{% if k == 'OPENAI_API_KEY' and not _vault_wrote_openai %}
{{ k }}={{ v }}
{% elif k == 'AWS_BEARER_TOKEN_BEDROCK' and not _vault_wrote_bearer %}
{{ k }}={{ v }}
{% elif k == 'AWS_ACCESS_KEY_ID' and not _vault_wrote_access_key %}
{{ k }}={{ v }}
{% elif k == 'AWS_SECRET_ACCESS_KEY' and not _vault_wrote_secret_key %}
{{ k }}={{ v }}
{% elif k == 'AWS_REGION' and not _vault_wrote_region %}
{{ k }}={{ v }}
{% elif k not in ['OPENAI_API_KEY', 'AWS_BEARER_TOKEN_BEDROCK', 'AWS_ACCESS_KEY_ID', 'AWS_SECRET_ACCESS_KEY', 'AWS_REGION'] %}
{{ k }}={{ v }}
{% endif %}
{% endif %}
{% endfor %}

# Disable telemetry
LITELLM_TELEMETRY=False
